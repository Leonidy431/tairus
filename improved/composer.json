{
  "name": "tairus/painting-sales",
  "description": "Modern refactored painting sales website with security and best practices",
  "type": "project",
  "license": "proprietary",
  "authors": [
    {
      "name": "Claude Code",
      "email": "code@anthropic.com"
    }
  ],
  "require": {
    "php": "^7.4",
    "ext-pdo": "*",
    "ext-json": "*",
    "stripe/stripe-php": "^9.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.0",
    "squizlabs/php_codesniffer": "^3.6",
    "phpmd/phpmd": "^2.11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Helpers/env.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit tests/Unit",
    "test:security": "phpunit tests/Security",
    "test:integration": "phpunit tests/Integration",
    "test:coverage": "phpunit --coverage-html coverage/html",
    "lint": "phpcs --standard=PSR12 src tests",
    "lint:fix": "phpcbf --standard=PSR12 src tests",
    "static-analysis": "phpstan analyse src --level=8",
    "audit": "phpmd src text cleancode,codesize,design,naming,unusedcode"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
